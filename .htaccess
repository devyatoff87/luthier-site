# .htaccess - Luthier Werkstatt Sicherheitsdatei

# Rewrite Engine aktivieren
RewriteEngine On

# ========== VERZEICHNISSCHUTZ ==========
# Verhindere Direktzugriff auf sensible Ordner
RedirectMatch 403 ^/includes/.*$
RedirectMatch 403 ^/cms/.*$
RedirectMatch 403 ^/config/.*$
RedirectMatch 403 ^/vendor/.*$
RedirectMatch 403 /\.git/.*$
RedirectMatch 403 /\.env$

# ========== DATEIEN SCHÜTZEN ==========
# Kein Zugriff auf diese Dateitypen (Konfigurationen)
<FilesMatch "\.(ini|json|log|sql|bak|sh|env|psd|zip|tar|gz)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Kein Zugriff auf sicherheitsrelevante PHP-Dateien
<FilesMatch "^(config|database|security)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ========== VERZEICHNISLISTING VERHINDERN ==========
Options -Indexes

# ========== UMBLEITUNGEN ==========
# WWW auf Non-WWW umleiten (SEO)
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# HTTP auf HTTPS umleiten (produktiv)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ========== TRAILING SLASH ==========
# Entfernt Slash am Ende der URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} /(.*)/$
RewriteRule ^ /%1 [R=301,L]

# ========== SCHÖNE URLS (für später) ==========
# Beispiel: /dienst/service-name → dienstleistungen.php?slug=service-name
# RewriteRule ^dienst/([a-z0-9-]+)$ dienstleistungen.php?slug=$1 [L,QSA]

# ========== CUSTOM ERROR PAGES ==========
ErrorDocument 403 /error/403.php
ErrorDocument 404 /error/404.php
ErrorDocument 500 /error/500.php

# ========== SICHERHEITS-HEADER ==========
<IfModule mod_headers.c>
    # XSS Schutz
    Header set X-XSS-Protection "1; mode=block"

    # Clickjacking Schutz
    Header set X-Frame-Options "SAMEORIGIN"

    # MIME-Type Sniffing verhindern
    Header set X-Content-Type-Options "nosniff"

    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ========== CACHING KONTROLLIEREN ==========
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>